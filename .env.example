# Supabase project (client + server)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Server-only — bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Code execution (self-hosted Piston instance behind an authenticated proxy)
PISTON_URL="https://your-piston-host"
PISTON_API_KEY="your-piston-api-key"

# Email (weekly digest, event reminders, mentor booking confirmations)
RESEND_API_KEY="your-resend-api-key"
DIGEST_FROM_EMAIL="Space <notifications@yourdomain.com>"
